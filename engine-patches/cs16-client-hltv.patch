+	if( hltv_reconstruction_camera && hltv_reconstruction_camera->value != 0.0f )
+	{
+		int entityIndex = hltv_reconstruction_entity ? (int)hltv_reconstruction_entity->value : 0;
+		cl_entity_t *entity = entityIndex > 0 ? gEngfuncs.GetEntityByIndex( entityIndex ) : NULL;
+		if( entity && entity->player )
+		{
+			V_GetInEyePos( entityIndex, pparams->vieworg, pparams->viewangles );
+		}
+		else
+		{
+			pparams->vieworg[0] = hltv_reconstruction_x->value;
+			pparams->vieworg[1] = hltv_reconstruction_y->value;
+			pparams->vieworg[2] = hltv_reconstruction_z->value;
+			pparams->viewangles[PITCH] = hltv_reconstruction_pitch->value;
+			pparams->viewangles[YAW] = hltv_reconstruction_yaw->value;
+			pparams->viewangles[ROLL] = hltv_reconstruction_roll->value;
+		}
+		VectorCopy( pparams->vieworg, v_origin );
+		VectorCopy( pparams->viewangles, v_angles );
+	}
+
+	// Normal local-demo view calculation restores the recorded client's gun
+	// after the spectator pass. Reapply the selected HLTV frag weapon last.
+	if( hltv_native_spectator && hltv_native_spectator->value != 0.0f &&
+		hltv_native_weapon && hltv_native_weapon->string[0] )
+	{
+		static int appliedMuzzleSerial = 0;
+		int requestedViewModelIndex = 0;
+		char requestedViewModelPath[MAX_MODEL_NAME];
+		snprintf( requestedViewModelPath, sizeof( requestedViewModelPath ),
+			"models/v_%s.mdl", hltv_native_weapon->string );
+		model_t *requestedViewModel = gEngfuncs.CL_LoadModel(
+			requestedViewModelPath, &requestedViewModelIndex );
+		cl_entity_t *gunModel = gEngfuncs.GetViewModel();
+		if( requestedViewModel && gunModel )
+		{
+			// Only replace the model identity. The event system owns sequence,
+			// frame and animtime; resetting frame here on every rendered frame
+			// freezes the firing animation and retriggers its studio events.
+			gunModel->model = requestedViewModel;
+			if( gunModel->curstate.modelindex != requestedViewModelIndex )
+				gunModel->curstate.modelindex = requestedViewModelIndex;
+			gunModel->curstate.colormap = 0;
+			gunModel->index = g_iUser2;
+			if( appliedMuzzleSerial != g_ReplayLabMuzzleSerial )
+			{
+				appliedMuzzleSerial = g_ReplayLabMuzzleSerial;
+				gunModel->curstate.animtime = g_ReplayLabMuzzleTime;
+				gunModel->curstate.frame = 0.0f;
+			}
+		}
+	}
 }
 
