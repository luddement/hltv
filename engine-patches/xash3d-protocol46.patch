+static void CL_CreateMissingDemoCorpse( int player )
+{
+	byte data[128];
+	sizebuf_t msg;
+	entity_state_t *death = &cls.demo_player_death_state[player];
+	model_t *model;
+	const char *modelname;
+	int sequence;
+
+	if( !cls.demoplayback || cls.demo_net_protocol >= 47
+		|| !cls.demo_player_dead[player]
+		|| cls.demo_player_corpse_seen[player]
+		|| cl.time < cls.demo_player_hide_time[player]
+		|| !death->modelindex )
+		return;
+
+	model = CL_ModelHandle( death->modelindex );
+	modelname = model && model->name[0] ? model->name : cl.players[player - 1].model;
+	if( !modelname[0] )
+		return;
+
+	// Modern CS player models share death1..death3 at 101..103 and the
+	// dedicated headshot animation at 104.  Build the same ClCorpse payload
+	// that the server would have sent, so gravity, collision and animation are
+	// handled by the real client instead of freezing a network player in place.
+	sequence = cls.demo_player_headshot[player] ? 104 : 101 + ( player % 3 );
+	MSG_Init( &msg, "legacy demo corpse", data, sizeof( data ));
+	MSG_WriteString( &msg, modelname );
+	MSG_WriteLong( &msg, death->origin[0] * 128.0f );
+	MSG_WriteLong( &msg, death->origin[1] * 128.0f );
+	MSG_WriteLong( &msg, death->origin[2] * 128.0f );
+	MSG_WriteCoord( &msg, death->angles[0] );
+	MSG_WriteCoord( &msg, death->angles[1] );
+	MSG_WriteCoord( &msg, death->angles[2] );
+	MSG_WriteLong( &msg, 0 );
+	MSG_WriteByte( &msg, sequence );
+	MSG_WriteByte( &msg, death->body );
+	MSG_WriteByte( &msg, death->team );
+	MSG_WriteByte( &msg, player );
+
+	cls.demo_player_corpse_seen[player] = true;
+	cls.demo_player_hide_time[player] = cl.time;
+	CL_DispatchUserMessage( "ClCorpse", MSG_GetNumBytesWritten( &msg ), data );
+}
