+/*
+==============
+CL_DemoInterpolateView
+
+Returns the final camera origin and orientation embedded in a legacy GoldSrc
+demo. Applying both after the client DLL's CalcRefdef avoids adding modern
+view punch a second time to an already rendered HLTV camera angle.
+==============
+*/
+qboolean CL_DemoInterpolateView( vec3_t vieworigin, vec3_t viewangles )
+{
+	demoangle_t *prev = NULL, *next = NULL;
+	float frac = 0.0f;
+	float curtime;
+
+	if( !cls.demoplayback || !demo.goldsrc_layout )
+		return false;
+
+	curtime = (CL_GetDemoPlaybackClock() - demo.starttime) - host.frametime;
+	if( curtime > demo.timestamp )
+		curtime = demo.timestamp;
+
+	CL_DemoFindInterpolatedViewAngles( curtime, &frac, &prev, &next );
+	if( !prev || !next || !prev->has_vieworigin || !next->has_vieworigin )
+		return false;
+
+	VectorLerp( prev->vieworigin, frac, next->vieworigin, vieworigin );
+	{
+		vec4_t q, q1, q2;
+
+		AngleQuaternion( next->viewangles, q1, false );
+		AngleQuaternion( prev->viewangles, q2, false );
+		QuaternionSlerp( q2, q1, frac, q );
+		QuaternionAngle( q, viewangles );
+	}
+	return true;
+}
