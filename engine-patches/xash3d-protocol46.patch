+static void CL_RecordGoldSrcView( float timestamp, const vec3_t vieworigin, const vec3_t viewangles )
+{
+	demoangle_t *a;
+	float sectiontime;
+
+	if( demo.entryIndex == 0 )
+		return; // the loading section has no playable camera timeline
+
+	// Playback timing is relative to the first packet in the directory entry,
+	// while HLDEMO stores absolute timestamps inside its demo_info blocks.
+	sectiontime = Q_max( timestamp - demo.realstarttime, 0.0001f );
+	if( demo.lasttime == sectiontime )
+		return;
+
+	demo.angle_position = (demo.angle_position + 1) & ANGLE_MASK;
+	a = &demo.cmds[demo.angle_position];
+	a->starttime = sectiontime;
+	VectorCopy( vieworigin, a->vieworigin );
+	VectorCopy( viewangles, a->viewangles );
+	a->has_vieworigin = true;
+	VectorCopy( viewangles, cl.cmd.viewangles );
+	demo.lasttime = sectiontime;
+}
+
+/*
+=================
+CL_DemoReadMessageGoldSrc
+
+Reads the original HLDEMO protocol 5 frame layout.  GoldSrc packet frames
+contain a tick number and a 464-byte demo_info block before the network
+message, while Xash's native demo format stores only the netchan sequences.
+=================
+*/
+static qboolean CL_DemoReadMessageGoldSrc( byte *buffer, size_t *length )
+{
+	for( ;; )
+	{
+		byte cmd;
+		float timestamp;
+		uint32_t tick, blockLength;
+		vec3_t vieworigin, viewangles;
+		size_t curpos = FS_Tell( cls.demofile );
+		float elapsed, sectiontime, fastforward_target;
+
+		if( FS_Read( cls.demofile, &cmd, sizeof( cmd )) != sizeof( cmd )
+			|| FS_Read( cls.demofile, &timestamp, sizeof( timestamp )) != sizeof( timestamp )
+			|| FS_Read( cls.demofile, &tick, sizeof( tick )) != sizeof( tick ))
+		{
+			CL_DemoCompleted();
+			return false;
+		}
+
+		if( cmd > 9 )
+		{
+			Con_Printf( S_ERROR "GoldSrc demo cmd %u > 9, file offset = %d\n",
+				cmd, (int)FS_Tell( cls.demofile ));
+			CL_DemoCompleted();
+			return false;
+		}
+
+		demo.timestamp = timestamp;
+
+		switch( cmd )
+		{
+		case 0: // dem_signon
+		case 1: // dem_packet
+		{
+			// GoldSrc timestamps are absolute server times. Normalize playback
+			// against the first packet in each directory section instead of using
+			// Xash's server-frame clock, which is not initialized during signon.
+			if( demo.entryIndex != 0 && !cls.timedemo )
+			{
+				if( demo.framecount == 0 )
+				{
+					demo.realstarttime = timestamp;
+					demo.starttime = CL_GetDemoPlaybackClock();
+				}
+				else
+				{
+					sectiontime = timestamp - demo.realstarttime;
+					fastforward_target = Cvar_VariableValue( "hltv_fastforward" );
+					if( fastforward_target > 0.0f )
+					{
+						if( sectiontime >= fastforward_target )
+						{
+							Cvar_SetValue( "hltv_fastforward", 0.0f );
+							demo.starttime = CL_GetDemoPlaybackClock() - sectiontime;
+							Con_Printf( "ReplayLab fast-forward complete at %.3f seconds.\n", sectiontime );
+						}
+					}
+					else
+					{
+						elapsed = CL_GetDemoPlaybackClock() - demo.starttime;
+						if( sectiontime > elapsed )
+						{
+							FS_Seek( cls.demofile, curpos, SEEK_SET );
+							return false;
+						}
+					}
+				}
+			}
+
+			// GoldSrc records the exact spectator camera origin and orientation
+			// together at the start of demo_info. Keep both on the same timeline;
+			// reconstructing the origin from the network player state makes the
+			// crosshair ray visibly miss narrow gaps in old HLTV recordings.
+			FS_Seek( cls.demofile, curpos + 9 + 4, SEEK_SET );
+			FS_Read( cls.demofile, vieworigin, sizeof( vieworigin ));
+			FS_Read( cls.demofile, viewangles, sizeof( viewangles ));
+			CL_RecordGoldSrcView( timestamp, vieworigin, viewangles );
+
+			// GoldSrc stores 436 bytes of camera/demo state followed by seven
+			// netchan integers and then the message length. Seek from the frame
+			// start so an implementation-specific FS cursor cannot accumulate an
+			// offset error between these fixed-width fields.
+			FS_Seek( cls.demofile, curpos + 9 + 436, SEEK_SET );
+			demo.framecount++;
+			CL_ReadDemoSequence( false );
+			FS_Seek( cls.demofile, curpos + 9 + 464, SEEK_SET );
+			return CL_ReadRawNetworkData( buffer, length );
+		}
+		case 2: // dem_synctick
+			break;
+		case 3: // dem_consolecmd
+			FS_Seek( cls.demofile, 64, SEEK_CUR );
+			break;
+		case 4: // dem_clientdata
+			FS_Seek( cls.demofile, 32, SEEK_CUR );
+			break;
+		case 5: // dem_nextsection
+			CL_DemoMoveToNextSection();
+			return false;
+		case 6: // dem_event
+		{
+			uint32_t flags, eventIndex;
+			float delay;
+			event_args_t args;
+
+			FS_Read( cls.demofile, &flags, sizeof( flags ));
+			FS_Read( cls.demofile, &eventIndex, sizeof( eventIndex ));
+			FS_Read( cls.demofile, &delay, sizeof( delay ));
+			FS_Read( cls.demofile, &args, sizeof( args ));
+			CL_PlaybackEvent( flags, NULL, (word)eventIndex, delay,
+				args.origin, args.angles, args.fparam1, args.fparam2,
+				args.iparam1, args.iparam2, args.bparam1, args.bparam2 );
+			break;
+		}
+		case 7: // dem_weaponanim
+		{
+			int animation, body;
+
+			FS_Read( cls.demofile, &animation, sizeof( animation ));
+			FS_Read( cls.demofile, &body, sizeof( body ));
+			CL_WeaponAnim( animation, body );
+			break;
+		}
+		case 8: // dem_sound
+			FS_Seek( cls.demofile, 4, SEEK_CUR ); // channel
+			FS_Read( cls.demofile, &blockLength, sizeof( blockLength ));
+			FS_Seek( cls.demofile, blockLength + 16, SEEK_CUR );
+			break;
+		case 9: // dem_demobuffer
+			FS_Read( cls.demofile, &blockLength, sizeof( blockLength ));
+			FS_Seek( cls.demofile, blockLength, SEEK_CUR );
+			break;
+		}
+	}
+}
